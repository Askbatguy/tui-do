#sidebar {
    width: 25%;
    background: $panel;
    border-right: solid $primary;
    padding: 1;
}

#main {
    width: 75%;
    padding: 1;
}

AddTodoModal, EditTodoModal, ConfirmDeleteModal, CategoryNameModal {
    align: center middle;
}

#dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: solid $primary;
    padding: 1 2;
}

#dialog-title {
    text-style: bold;
    width: 100%;
    margin-bottom: 1;
}

#dialog-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

CategoryList:focus {
    border: solid $accent;
}

TodoTable:focus {
    border: solid $accent;
}

.selected-category {
    background: $accent;
    color: $text;
}