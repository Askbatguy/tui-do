#sidebar {
    width: 25%;
    background: $panel;
    border-right: solid $primary;
    padding: 1;
}

#main-panel {
    width: 75%;
}

#todo-header {
    height: 3;
    padding: 1;
    background: $secondary-darken-2;
}

#category-label {
    width: 1fr;
}

#task-count {
    width: auto;
}

#todo-progress {
    width: 1fr;
    height: 1;
    margin: 0 1;
}

#todo-progress > Bar {
    width: 1fr;
}

#main {
    padding: 1;
}

AddTodoModal, EditTodoModal, ConfirmDeleteModal, CategoryNameModal, TodoDetailModal, GlobalSearchModal {
    align: center middle;
}

#dialog {
    width: 60;
    height: auto;
    background: $surface;
    border: solid $primary;
    padding: 1 2;
}

#dialog-title {
    text-style: bold;
    width: 100%;
    margin-bottom: 1;
}

#dialog-buttons {
    width: 100%;
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

CategoryList:focus {
    border: solid $accent;
}

TodoTable:focus {
    border: solid $accent;
}

.selected-category {
    background: $accent;
    color: $text;
}

SplashScreen {
    align: center middle;
}

#splash {
    width: 100;
    height: auto;
    background: $surface;
    border: double $accent;
    padding: 2 4;
    align: center middle;
}

#splash-title {
    color: $accent;
    width: 100%;
    text-align: center; 
}

#splash-subtitle {
    width: 100%;
    text-align: center;
    color: $text-muted;
    margin-top: 1;
}

#splash-hint {
    width: 100%;
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

#todo-detail {
    width: 60;
    height: auto;
    background: $surface;
    border: solid $primary;
    padding: 2 4;
}

#detail-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
    text-align: center;
    width: 100%;
}

#detail-hint {
    margin-top: 1;
    text-align: center;
    width: 100%;
}

#splash-hint {
    width: 100%;
    text-align: center;
    color: $text-muted;
    text-style: italic;
    margin-top: 1;
}

#splash-divider {
    margin-top: 0;
    margin-bottom: 0;
}

#splash-brief-title {
    width: 100%;
    text-align: center;
    color: $primary-lighten-3;
    text-style: bold;
    padding: 0 0;
}

#help-menu {
    padding: 1 4;
}

#help-content {
    width: 100%;
}

#search-panel {
    width: 100;
    height: 70%;
    background: $surface;
    border: double $accent;
    padding: 2 4;
    align: center middle;
}

#search-hint {
    text-align: right;
    color: $text-muted;
    margin-bottom: 1;
}

#search-field {
    margin-bottom: 1;
}

.result-header {
    text-align: center;
    color: $text-muted;
    margin: 0;
}

#search-results {
    margin-top: 0;
    height: 1fr;
    border: solid $primary; 
}
